// Jewelry ERP - Complete Prisma Database Schema
// Covers: Sales, Purchase, Inventory, Accounts, Branch, GST, CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================================

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  fullName    String
  role        UserRole  @default(USER)
  isActive    Boolean   @default(true)
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  branchId    Int?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  salesVouchers     SalesVoucher[]
  purchaseVouchers  PurchaseVoucher[]
  cashEntries       CashEntry[]
  bankEntries       BankEntry[]
  refreshTokens     RefreshToken[]
  attachments       Attachment[]

  @@index([companyId])
  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  USER
}

// ============================================================
// COMPANY & BRANCH MANAGEMENT
// ============================================================

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  gstin       String?
  pan         String?
  logo        Bytes?
  financialYearStart DateTime
  financialYearEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]
  users       User[]
  accounts    Account[]
  salesmen    Salesman[]
  metalRates  MetalRate[]
  labelPrefixes LabelPrefix[]
  voucherSequences VoucherSequence[]
  salesVouchers    SalesVoucher[]
  purchaseVouchers PurchaseVoucher[]
  cashEntries      CashEntry[]
  bankEntries      BankEntry[]
  journalEntries   JournalEntry[]
  branchTransfers  BranchTransfer[]
  layawayEntries   LayawayEntry[]
  customerPayments CustomerPayment[]
  savingsSchemes   SavingsScheme[]
  auditLogs        AuditLog[]
  attachments      Attachment[]
  stockRequests    StockRequest[]

  @@map("companies")
}

model Branch {
  id          Int         @id @default(autoincrement())
  name        String
  code        String
  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id])
  branchType  BranchType  @default(BRANCH)
  isMaster    Boolean     @default(false)
  parentId    Int?        // null for master, master's id for branches
  parent      Branch?     @relation("BranchHierarchy", fields: [parentId], references: [id])
  children    Branch[]    @relation("BranchHierarchy")
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  gstin       String?
  isActive    Boolean     @default(true)
  isDeleted   Boolean     @default(false)
  deletedAt   DateTime?
  deletedBy   Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users              User[]
  counters           Counter[]
  salesVouchers      SalesVoucher[]
  purchaseVouchers   PurchaseVoucher[]
  cashEntries        CashEntry[]
  bankEntries        BankEntry[]
  branchIssues       BranchTransfer[]  @relation("IssuingBranch")
  branchReceipts     BranchTransfer[]  @relation("ReceivingBranch")
  labels             Label[]
  layawayEntries     LayawayEntry[]
  savingsSchemes     SavingsScheme[]
  accounts           Account[]
  staff              BranchStaff[]
  auditLogs          AuditLog[]
  stockRequestsMade  StockRequest[]  @relation("RequestingBranch")
  stockRequestsFrom  StockRequest[]  @relation("SourceBranch")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@map("branches")
}

enum BranchType {
  MASTER
  BRANCH
}

model Counter {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id])
  isActive    Boolean  @default(true)

  labels      Label[]

  @@map("counters")
}

// ============================================================
// MASTER DATA - ITEMS & METALS
// ============================================================

model MetalType {
  id          Int      @id @default(autoincrement())
  name        String   @unique  // GOLD, SILVER, PLATINUM, DIAMOND
  code        String   @unique
  isActive    Boolean  @default(true)

  itemGroups  ItemGroup[]
  metalRates  MetalRate[]
  items       Item[]

  @@map("metal_types")
}

model ItemGroup {
  id            Int        @id @default(autoincrement())
  name          String     // e.g., "RING", "CHAIN", "BANGLE", "EARRING"
  code          String     @unique
  metalTypeId   Int
  metalType     MetalType  @relation(fields: [metalTypeId], references: [id])
  hsnCode       String?    // HSN Code for GST (711319 for gold jewelry)
  cgstRate      Decimal    @default(1.5)
  sgstRate      Decimal    @default(1.5)
  igstRate      Decimal    @default(3.0)
  requiresTagId Boolean    @default(false) // If true, labels require physical tag ID (chains, bangles, coins)
  isActive      Boolean    @default(true)

  items       Item[]
  prefixes    LabelPrefix[]

  @@map("item_groups")
}

model Purity {
  id          Int      @id @default(autoincrement())
  name        String   // "22 KT", "18 KT", "14 KTD", "24 KT"
  code        String   @unique  // "22KT", "18KT", "14KTD", "24KT"
  percentage  Decimal  // 91.67 for 22KT, 75.0 for 18KT
  isActive    Boolean  @default(true)

  items       Item[]

  @@map("purities")
}

model Item {
  id            Int        @id @default(autoincrement())
  name          String     // "AACHARYA RING 22KT", "CHAIN-22KT"
  code          String     @unique
  itemGroupId   Int
  itemGroup     ItemGroup  @relation(fields: [itemGroupId], references: [id])
  metalTypeId   Int
  metalType     MetalType  @relation(fields: [metalTypeId], references: [id])
  purityId      Int
  purity        Purity     @relation(fields: [purityId], references: [id])
  description   String?
  mrp           Decimal?
  salePrice     Decimal?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  labels        Label[]
  salesItems    SalesItem[]
  purchaseItems PurchaseItem[]
  layawayItems  LayawayItem[]

  @@map("items")
}

model LabelPrefix {
  id          Int       @id @default(autoincrement())
  prefix      String    @unique  // "AA22", "CH22", "GR22"
  itemGroupId Int
  itemGroup   ItemGroup @relation(fields: [itemGroupId], references: [id])
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  lastNumber  Int       @default(0)
  isActive    Boolean   @default(true)

  labels      Label[]

  @@index([companyId])
  @@map("label_prefixes")
}

model Label {
  id            Int          @id @default(autoincrement())
  labelNo       String       @unique  // "PA22/509" or "CH22/A001" (with tagId)
  prefixId      Int
  prefix        LabelPrefix  @relation(fields: [prefixId], references: [id])
  tagId         String?      // Physical tag ID (e.g., "A001") for items requiring manual tagging
  itemId        Int
  item          Item         @relation(fields: [itemId], references: [id])
  grossWeight   Decimal      @default(0)
  netWeight     Decimal      @default(0)
  pcsCount      Int          @default(1)
  mrp           Decimal?
  salePrice     Decimal?
  branchId      Int
  branch        Branch       @relation(fields: [branchId], references: [id])
  counterId     Int?
  counter       Counter?     @relation(fields: [counterId], references: [id])
  status        LabelStatus  @default(IN_STOCK)
  huid          String?      // Hallmark Unique ID
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  salesItems    SalesItem[]
  purchaseItems PurchaseItem[]
  branchTransferItems BranchTransferItem[]
  layawayItems  LayawayItem[]
  stockRequestItems StockRequestItem[]

  @@unique([prefixId, tagId]) // tagId must be unique within each prefix
  @@map("labels")
}

enum LabelStatus {
  IN_STOCK
  SOLD
  TRANSFERRED
  ON_APPROVAL
  RETURNED
  LAYAWAY
}

// ============================================================
// METAL RATES
// ============================================================

model MetalRate {
  id          Int       @id @default(autoincrement())
  metalTypeId Int
  metalType   MetalType @relation(fields: [metalTypeId], references: [id])
  purityCode  String    // "22KT", "24KT"
  rate        Decimal   // Rate per gram
  date        DateTime  @default(now())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  isActive    Boolean   @default(true)

  @@unique([companyId, metalTypeId, purityCode, date])
  @@index([companyId])
  @@map("metal_rates")
}

// ============================================================
// CUSTOMER / ACCOUNT MANAGEMENT
// ============================================================

model Account {
  id            Int           @id @default(autoincrement())
  name          String
  type          AccountType
  groupHead     String?       @default("Sundry Debtors")
  customerCategory String?    @default("Normal")
  mobile        String?
  phone         String?
  email         String?
  blockNo       String?
  building      String?
  street        String?
  area          String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?
  gstVerified   Boolean       @default(false)
  gstTradeName  String?
  gstStatus     String?
  compositionScheme Boolean   @default(false)
  pan           String?
  aadhar        String?
  idProof       String?
  reference     String?
  remark        String?
  closingBalance Decimal      @default(0)
  balanceType   BalanceType   @default(NONE)
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id])
  branchId      Int?          // Branch-level data isolation
  branch        Branch?       @relation(fields: [branchId], references: [id])
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  salesVouchers    SalesVoucher[]
  purchaseVouchers PurchaseVoucher[]
  cashEntries      CashEntryLine[]
  layawayEntries   LayawayEntry[]
  journalEntries   JournalEntryLine[]
  customerPayments CustomerPayment[]
  savingsSchemes   SavingsScheme[]

  @@index([companyId])
  @@index([branchId])
  @@map("accounts")
}

enum AccountType {
  CUSTOMER
  SUPPLIER
  BRANCH
  BANK
  CASH
  EXPENSE
  INCOME
  SALESMAN
}

enum BalanceType {
  CR
  DR
  NONE
}

// ============================================================
// SALESMAN
// ============================================================

model Salesman {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  mobile      String?
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  isActive    Boolean  @default(true)

  salesVouchers SalesVoucher[]

  @@index([companyId])
  @@map("salesmen")
}

// ============================================================
// SALES MODULE
// ============================================================

model SalesVoucher {
  id              Int            @id @default(autoincrement())
  voucherNo       String         @unique  // "JGI/1115"
  voucherPrefix   String         @default("JGI")
  voucherNumber   Int
  voucherDate     DateTime       @default(now())
  accountId       Int
  account         Account        @relation(fields: [accountId], references: [id])
  salesmanId      Int?
  salesman        Salesman?      @relation(fields: [salesmanId], references: [id])
  companyId       Int
  company         Company        @relation(fields: [companyId], references: [id])
  branchId        Int
  branch          Branch         @relation(fields: [branchId], references: [id])
  userId          Int
  user            User           @relation(fields: [userId], references: [id])

  // Weight totals
  totalGrossWeight Decimal       @default(0)
  totalNetWeight   Decimal       @default(0)
  totalPcs         Int           @default(0)

  // Amount breakdowns
  metalAmount      Decimal       @default(0)
  labourAmount     Decimal       @default(0)
  otherCharge      Decimal       @default(0)
  discountStAmount Decimal       @default(0) // Diamond/Stone amount
  totalAmount      Decimal       @default(0)
  taxableAmount    Decimal       @default(0)

  // GST
  cgstAmount       Decimal       @default(0)
  sgstAmount       Decimal       @default(0)
  igstAmount       Decimal       @default(0)
  totalGstAmount   Decimal       @default(0)

  // Discount
  discountPercent  Decimal       @default(0)
  discountAmount   Decimal       @default(0)
  roundingDiscount Decimal       @default(0)

  // Final
  voucherAmount    Decimal       @default(0)  // Total bill amount

  // Payment
  cashAmount       Decimal       @default(0)
  bankAmount       Decimal       @default(0)
  cardAmount       Decimal       @default(0)
  upiAmount        Decimal       @default(0)
  oldGoldAmount    Decimal       @default(0)  // OG Purchase adjustment
  advanceAmount    Decimal       @default(0)  // Advance payment used from customer balance

  paymentAmount    Decimal       @default(0)  // Total paid
  dueAmount        Decimal       @default(0)  // Amount due
  previousOs       Decimal       @default(0)  // Previous outstanding
  finalDue         Decimal       @default(0)  // Final due amount

  // Discount scheme
  discountScheme   String?

  narration        String?
  reference        String?
  isReturned       Boolean        @default(false)
  status           VoucherStatus  @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            SalesItem[]

  @@index([companyId])
  @@index([voucherDate])
  @@index([accountId])
  @@map("sales_vouchers")
}

model SalesItem {
  id              Int           @id @default(autoincrement())
  salesVoucherId  Int
  salesVoucher    SalesVoucher  @relation(fields: [salesVoucherId], references: [id], onDelete: Cascade)
  labelId         Int?
  label           Label?        @relation(fields: [labelId], references: [id])
  itemId          Int
  item            Item          @relation(fields: [itemId], references: [id])

  labelNo         String?
  itemName        String
  grossWeight     Decimal       @default(0)
  netWeight       Decimal       @default(0)
  fineWeight      Decimal       @default(0)
  pcs             Int           @default(1)

  metalRate       Decimal       @default(0)
  metalAmount     Decimal       @default(0)
  diamondWeight   Decimal       @default(0)

  labourRate      Decimal       @default(0)
  labourAmount    Decimal       @default(0)

  otherCharge     Decimal       @default(0)
  discountStAmt   Decimal       @default(0) // Di/St Amount

  totalAmount     Decimal       @default(0)
  taxableAmount   Decimal       @default(0)

  // Style / Less Weight details
  styleName       String?
  lessWeight      Decimal       @default(0)

  createdAt       DateTime      @default(now())

  @@map("sales_items")
}

// ============================================================
// PURCHASE MODULE (URD / Old Gold)
// ============================================================

model PurchaseVoucher {
  id              Int            @id @default(autoincrement())
  voucherNo       String         @unique
  voucherPrefix   String         @default("PUR")
  voucherNumber   Int
  voucherDate     DateTime       @default(now())
  purchaseType    PurchaseType   @default(URD)

  accountId       Int
  account         Account        @relation(fields: [accountId], references: [id])
  companyId       Int
  company         Company        @relation(fields: [companyId], references: [id])
  branchId        Int
  branch          Branch         @relation(fields: [branchId], references: [id])
  userId          Int
  user            User           @relation(fields: [userId], references: [id])

  description     String?        // "OLD GOLD NEW"
  variety         String?
  group           String?        // "OGN"

  // Weight totals
  totalGrossWeight Decimal       @default(0)
  totalNetWeight   Decimal       @default(0)
  totalFineWeight  Decimal       @default(0)
  totalPcs         Int           @default(0)
  otherWeight      Decimal       @default(0)
  purity           Decimal       @default(0)  // e.g., 80.00

  // Amounts
  metalRate        Decimal       @default(0)
  metalAmount      Decimal       @default(0)
  otherCharge      Decimal       @default(0)
  valAddAmount     Decimal       @default(0)
  totalAmount      Decimal       @default(0)
  finalAmount      Decimal       @default(0)

  // Salesman
  salesmanName     String?

  narration        String?
  reference        String?
  status           VoucherStatus  @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            PurchaseItem[]

  @@index([companyId])
  @@index([voucherDate])
  @@map("purchase_vouchers")
}

enum PurchaseType {
  URD       // Unregistered dealer (Old Gold)
  REGULAR   // Regular purchase
  IMPORT    // Import
}

model PurchaseItem {
  id                Int              @id @default(autoincrement())
  purchaseVoucherId Int
  purchaseVoucher   PurchaseVoucher  @relation(fields: [purchaseVoucherId], references: [id], onDelete: Cascade)
  labelId           Int?
  label             Label?           @relation(fields: [labelId], references: [id])
  itemId            Int?
  item              Item?            @relation(fields: [itemId], references: [id])

  styleName         String?
  weight            Decimal          @default(0)
  pcs               Int              @default(0)
  amtCalcOn         String?          // "Weight"
  rate              Decimal          @default(0)
  amount            Decimal          @default(0)

  createdAt         DateTime         @default(now())

  @@map("purchase_items")
}

// ============================================================
// CASH & BANK ENTRIES
// ============================================================

model CashEntry {
  id            Int           @id @default(autoincrement())
  voucherNo     String        @unique  // "CI/111"
  voucherPrefix String
  voucherNumber Int
  voucherDate   DateTime      @default(now())
  voucherType   CashVoucherType  // Receipt or Payment
  bookName      String        @default("Cash")
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id])
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  userId        Int
  user          User          @relation(fields: [userId], references: [id])

  totalCredit   Decimal       @default(0)
  totalDebit    Decimal       @default(0)
  balance       Decimal       @default(0)

  reverseCharge Boolean       @default(false)
  placeOfSupply String?
  narration     String?
  reference     String?
  status        VoucherStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines         CashEntryLine[]

  @@index([companyId])
  @@index([voucherDate])
  @@map("cash_entries")
}

enum CashVoucherType {
  RECEIPT
  PAYMENT
}

model CashEntryLine {
  id            Int       @id @default(autoincrement())
  cashEntryId   Int
  cashEntry     CashEntry @relation(fields: [cashEntryId], references: [id], onDelete: Cascade)
  crDr          String    // "CR" or "DR"
  accountId     Int
  account       Account   @relation(fields: [accountId], references: [id])
  date          DateTime
  amount        Decimal   @default(0)
  tdsAmount     Decimal   @default(0)
  tcsAmount     Decimal   @default(0)
  netAmount     Decimal   @default(0)
  gstApplicable Boolean   @default(false)
  narration     String?

  @@map("cash_entry_lines")
}

model BankEntry {
  id            Int           @id @default(autoincrement())
  voucherNo     String        @unique
  voucherPrefix String
  voucherNumber Int
  voucherDate   DateTime      @default(now())
  voucherType   String        // "Receipt", "Payment", "Transfer"
  bookName      String
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id])
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  userId        Int
  user          User          @relation(fields: [userId], references: [id])

  totalAmount   Decimal       @default(0)
  narration     String?
  reference     String?
  chequeNo      String?
  chequeDate    DateTime?
  status        VoucherStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId])
  @@index([voucherDate])
  @@map("bank_entries")
}

// ============================================================
// JOURNAL / DEBIT NOTE / CREDIT NOTE
// ============================================================

model JournalEntry {
  id            Int           @id @default(autoincrement())
  voucherNo     String        @unique
  voucherPrefix String
  voucherNumber Int
  voucherDate   DateTime      @default(now())
  entryType     JournalType
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id])
  narration     String?
  reference     String?
  totalAmount   Decimal       @default(0)
  status        VoucherStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines         JournalEntryLine[]

  @@index([companyId])
  @@map("journal_entries")
}

enum JournalType {
  JOURNAL
  DEBIT_NOTE
  CREDIT_NOTE
}

model JournalEntryLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id])
  crDr           String       // "CR" or "DR"
  amount         Decimal      @default(0)
  narration      String?

  @@map("journal_entry_lines")
}

// ============================================================
// BRANCH TRANSFERS
// ============================================================

model BranchTransfer {
  id                Int      @id @default(autoincrement())
  voucherNo         String   @unique  // "GBI/91", "GBR/245"
  voucherPrefix     String
  voucherNumber     Int
  voucherDate       DateTime @default(now())
  transferType      TransferType  // ISSUE or RECEIPT
  companyId         Int
  company           Company  @relation(fields: [companyId], references: [id])

  issuingBranchId   Int
  issuingBranch     Branch   @relation("IssuingBranch", fields: [issuingBranchId], references: [id])
  receivingBranchId Int
  receivingBranch   Branch   @relation("ReceivingBranch", fields: [receivingBranchId], references: [id])

  totalGrossWeight  Decimal  @default(0)
  totalNetWeight    Decimal  @default(0)
  totalPcs          Int      @default(0)
  totalAmount       Decimal  @default(0)
  billNo            String?

  narration         String?
  reference         String?
  status            VoucherStatus @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             BranchTransferItem[]

  @@index([companyId])
  @@index([voucherDate])
  @@map("branch_transfers")
}

enum TransferType {
  ISSUE
  RECEIPT
}

model BranchTransferItem {
  id                Int            @id @default(autoincrement())
  branchTransferId  Int
  branchTransfer    BranchTransfer @relation(fields: [branchTransferId], references: [id], onDelete: Cascade)
  labelId           Int?
  label             Label?         @relation(fields: [labelId], references: [id])
  itemName          String
  grossWeight       Decimal        @default(0)
  netWeight         Decimal        @default(0)
  pcs               Int            @default(1)
  purityName        String?
  otherCharge       Decimal        @default(0)
  labourRate        Decimal        @default(0)
  labourAmount      Decimal        @default(0)
  metalAmount       Decimal        @default(0)
  totalAmount       Decimal        @default(0)

  @@map("branch_transfer_items")
}

// ============================================================
// LAYAWAY (Label-Based Reservation) ENTRIES
// ============================================================

model LayawayEntry {
  id              Int           @id @default(autoincrement())
  voucherNo       String        @unique  // "LY/317"
  voucherPrefix   String        @default("LY")
  voucherNumber   Int
  voucherDate     DateTime      @default(now())
  dueDate         DateTime?
  expiryDate      DateTime?     // Reservation expiry date
  pricingModel    String        @default("FLOATING") // LOCKED | FLOATING | HYBRID
  metalRateAtBooking Decimal    @default(0)          // Gold rate snapshot at booking time
  accountId       Int
  account         Account       @relation(fields: [accountId], references: [id])
  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id])
  branchId        Int
  branch          Branch        @relation(fields: [branchId], references: [id])
  salesmanName    String?

  // Item totals
  totalGrossWeight Decimal      @default(0)
  totalNetWeight   Decimal      @default(0)
  totalFineWeight  Decimal      @default(0)
  totalPcs         Int          @default(0)
  metalAmount      Decimal      @default(0)
  labourAmount     Decimal      @default(0)
  otherCharge      Decimal      @default(0)
  discountAmount   Decimal      @default(0)

  // GST
  taxableAmount    Decimal      @default(0)
  cgstAmount       Decimal      @default(0)
  sgstAmount       Decimal      @default(0)
  totalAmount      Decimal      @default(0)
  roundingDiscount Decimal      @default(0)
  voucherAmount    Decimal      @default(0)

  // Payment tracking
  cashAmount       Decimal      @default(0)
  bankAmount       Decimal      @default(0)
  cardAmount       Decimal      @default(0)
  upiAmount        Decimal      @default(0)
  oldGoldAmount    Decimal      @default(0)
  paymentAmount    Decimal      @default(0)  // Running total of all payments collected
  dueAmount        Decimal      @default(0)  // voucherAmount - paymentAmount
  previousOs       Decimal      @default(0)
  finalDue         Decimal      @default(0)

  // Conversion tracking
  convertedToSaleId String?     // Sale voucher number after conversion

  narration        String?
  reference        String?
  bookName         String?
  status           LayawayStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  items            LayawayItem[]
  payments         LayawayPayment[]
  statusHistory    LayawayStatusHistory[]

  @@index([accountId, status])
  @@index([expiryDate, status])
  @@map("layaway_entries")
}

model LayawayItem {
  id              Int          @id @default(autoincrement())
  layawayEntryId  Int
  layawayEntry    LayawayEntry @relation(fields: [layawayEntryId], references: [id], onDelete: Cascade)
  labelId         Int?
  label           Label?       @relation(fields: [labelId], references: [id])
  itemId          Int
  item            Item         @relation(fields: [itemId], references: [id])
  labelNo         String
  itemName        String
  grossWeight     Decimal      @default(0)
  netWeight       Decimal      @default(0)
  fineWeight      Decimal      @default(0)
  pcs             Int          @default(1)
  metalRate       Decimal      @default(0)   // Booking-time metal rate snapshot
  metalAmount     Decimal      @default(0)
  diamondWeight   Decimal      @default(0)
  labourRate      Decimal      @default(0)
  labourAmount    Decimal      @default(0)
  otherCharge     Decimal      @default(0)
  discountAmt     Decimal      @default(0)
  taxableAmount   Decimal      @default(0)
  totalAmount     Decimal      @default(0)

  @@map("layaway_items")
}

enum LayawayStatus {
  ACTIVE
  PARTIALLY_PAID
  OVERDUE
  READY_FOR_CONVERSION
  COMPLETED
  CONVERTED
  CANCELLED
  EXPIRED
}

model LayawayPayment {
  id            Int          @id @default(autoincrement())
  layawayId     Int
  layaway       LayawayEntry @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  paymentDate   DateTime     @default(now())
  amount        Decimal
  paymentMode   String       // "Cash", "Bank", "Card", "UPI"
  reference     String?
  narration     String?

  @@map("layaway_payments")
}

// Status transition audit trail
model LayawayStatusHistory {
  id            Int          @id @default(autoincrement())
  layawayId     Int
  layaway       LayawayEntry @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  fromStatus    String
  toStatus      String
  changedBy     String       @default("SYSTEM")
  reason        String?
  changedAt     DateTime     @default(now())

  @@index([layawayId, changedAt])
  @@map("layaway_status_history")
}

// ============================================================
// CUSTOMER PAYMENTS (Advance / Due Payments & Balance History)
// ============================================================

model CustomerPayment {
  id            Int           @id @default(autoincrement())
  receiptNo     String        @unique  // "CPR/1"
  receiptPrefix String        @default("CPR")
  receiptNumber Int
  paymentDate   DateTime      @default(now())
  accountId     Int
  account       Account       @relation(fields: [accountId], references: [id])
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id])
  paymentType   PaymentType   // ADVANCE (before purchase) or DUE_PAYMENT (against outstanding)

  // Multi-source payment
  cashAmount    Decimal       @default(0)
  bankAmount    Decimal       @default(0)
  cardAmount    Decimal       @default(0)
  upiAmount     Decimal       @default(0)
  oldGoldGross  Decimal       @default(0)  // Old gold gross weight (grams)
  oldGoldNet    Decimal       @default(0)  // Old gold net weight after deductions (grams)
  oldGoldRate   Decimal       @default(0)  // Gold rate per gram used for valuation
  oldGoldAmount Decimal       @default(0)  // oldGoldNet × oldGoldRate
  totalAmount   Decimal       @default(0)  // Sum of all payment sources

  // Balance tracking
  balanceBefore Decimal       @default(0)  // Customer closing balance before this payment
  balanceAfter  Decimal       @default(0)  // Customer closing balance after this payment

  // References
  salesVoucherId Int?         // If paying against a specific sale
  bankName      String?       // Bank name for bank payment
  chequeNo      String?       // Cheque / UTR reference
  narration     String?
  reference     String?
  status        VoucherStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId])
  @@index([accountId])
  @@index([paymentDate])
  @@map("customer_payments")
}

enum PaymentType {
  ADVANCE
  DUE_PAYMENT
  REFUND
}

// ============================================================
// COMMON ENUMS
// ============================================================

enum VoucherStatus {
  ACTIVE
  CANCELLED
  VOID
  CLOSED
}

// ============================================================
// VOUCHER NUMBER SEQUENCES
// ============================================================

model VoucherSequence {
  id          Int      @id @default(autoincrement())
  prefix      String
  entityType  String   // "SALES", "PURCHASE", "CASH", "BANK", "BRANCH_ISSUE", etc.
  lastNumber  Int      @default(0)
  financialYear String // "2025-2026"
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, prefix, entityType, financialYear])
  @@map("voucher_sequences")
}

// ============================================================
// GST CONFIGURATION
// ============================================================

model GstConfig {
  id          Int      @id @default(autoincrement())
  hsnCode     String
  description String?
  cgstRate    Decimal  @default(1.5)
  sgstRate    Decimal  @default(1.5)
  igstRate    Decimal  @default(3.0)
  isActive    Boolean  @default(true)

  @@map("gst_configs")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  action      String   // "CREATE", "UPDATE", "DELETE", "TRANSFER", "DISABLE", "OVERRIDE"
  entityType  String   // "SalesVoucher", "Branch", "BranchTransfer", etc.
  entityId    Int
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([branchId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// INTER-BRANCH STOCK REQUESTS
// ============================================================

model StockRequest {
  id                  Int               @id @default(autoincrement())
  requestNo           String            @unique
  requestDate         DateTime          @default(now())
  requestingBranchId  Int
  requestingBranch    Branch            @relation("RequestingBranch", fields: [requestingBranchId], references: [id])
  sourceBranchId      Int
  sourceBranch        Branch            @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  companyId           Int
  company             Company           @relation(fields: [companyId], references: [id])
  requestedById       Int
  status              StockRequestStatus @default(PENDING)
  approvedById        Int?
  approvedAt          DateTime?
  rejectedById        Int?
  rejectedAt          DateTime?
  rejectionReason     String?
  narration           String?
  totalPcs            Int               @default(0)
  totalGrossWeight    Decimal           @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  items               StockRequestItem[]

  @@index([companyId])
  @@index([requestingBranchId])
  @@index([sourceBranchId])
  @@map("stock_requests")
}

model StockRequestItem {
  id              Int           @id @default(autoincrement())
  stockRequestId  Int
  stockRequest    StockRequest  @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  labelId         Int
  label           Label         @relation(fields: [labelId], references: [id])
  labelNo         String
  itemName        String
  grossWeight     Decimal       @default(0)
  netWeight       Decimal       @default(0)
  pcs             Int           @default(1)
  purityName      String?

  @@map("stock_request_items")
}

enum StockRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// REFRESH TOKENS (Session management for web auth)
// ============================================================

model RefreshToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   Int
  branchId    Int?
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================
// BRANCH STAFF (Future: per-branch role-based access)
// ============================================================

model BranchStaff {
  id          Int      @id @default(autoincrement())
  userId      Int
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id])
  role        String   @default("STAFF")  // MANAGER, CASHIER, STAFF
  isActive    Boolean  @default(true)
  assignedAt  DateTime @default(now())
  removedAt   DateTime?

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("branch_staff")
}

// ============================================================
// SAVINGS SCHEME (Monthly Installment Plan)
// ============================================================

model SavingsScheme {
  id              Int              @id @default(autoincrement())
  schemeNo        String           @unique  // "SS/1"
  schemePrefix    String           @default("SS")
  schemeNumber    Int
  schemeName      String           @default("Gold Savings Scheme")
  startDate       DateTime         @default(now())
  maturityDate    DateTime
  accountId       Int
  account         Account          @relation(fields: [accountId], references: [id])
  companyId       Int
  company         Company          @relation(fields: [companyId], references: [id])
  branchId        Int
  branch          Branch           @relation(fields: [branchId], references: [id])

  // Scheme config
  durationMonths  Int              @default(11)   // Total installment months
  monthlyAmount   Decimal          @default(0)    // Fixed monthly installment amount
  bonusMonths     Int              @default(1)    // Bonus months given by shop on completion
  bonusAmount     Decimal          @default(0)    // bonusMonths × monthlyAmount (auto-calculated)

  // Tracking
  paidInstallments Int             @default(0)    // Number of installments paid
  missedInstallments Int           @default(0)    // Number of missed installments
  totalPaidAmount  Decimal         @default(0)    // Sum of all installment payments
  maturityValue    Decimal         @default(0)    // totalPaidAmount + bonusAmount

  narration       String?
  reference       String?
  status          SchemeStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  installments    SchemeInstallment[]

  @@index([companyId])
  @@index([accountId])
  @@index([branchId])
  @@index([startDate])
  @@map("savings_schemes")
}

model SchemeInstallment {
  id              Int              @id @default(autoincrement())
  schemeId        Int
  scheme          SavingsScheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  installmentNo   Int              // 1, 2, 3, ... up to durationMonths
  dueDate         DateTime         // Expected payment date for this installment
  paidDate        DateTime?        // Actual payment date (null if unpaid)
  amount          Decimal          @default(0)    // Amount paid
  paymentMode     String?          // "Cash", "Bank", "Card", "UPI"
  reference       String?          // Transaction reference / cheque no
  narration       String?
  status          InstallmentStatus @default(PENDING)
  createdAt       DateTime         @default(now())

  @@unique([schemeId, installmentNo])
  @@map("scheme_installments")
}

enum SchemeStatus {
  ACTIVE
  MATURED       // All installments paid, awaiting redemption
  REDEEMED      // Converted against a sale
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  MISSED
}

// ============================================================
// FILE ATTACHMENTS (Web-first file storage)
// ============================================================
// Stores metadata for uploaded files. Actual file bytes live in
// object storage (local disk in dev, S3/Minio in production).
// Downloads served via time-limited signed URLs.

model Attachment {
  id            Int      @id @default(autoincrement())
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  uploadedById  Int
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])

  // What this attachment belongs to (polymorphic via entityType + entityId)
  entityType    String   // e.g. "SalesVoucher", "PurchaseVoucher", "Account", "Label"
  entityId      Int

  // File metadata
  originalName  String   // User-visible filename
  storagePath   String   // Internal key in object storage
  mimeType      String
  sizeBytes     Int
  category      String   @default("document") // "document", "image", "invoice", "certificate"

  createdAt     DateTime @default(now())
  deletedAt     DateTime? // soft delete

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([uploadedById])
  @@map("attachments")
}
