# ─────────────────────────────────────────────────────────────
# JewelERP Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy to .env for local development. For staging/production,
# inject these as environment variables in Docker or your hosting platform.
#
# Environments: development | staging | production | test
# ─────────────────────────────────────────────────────────────

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_VERSION=1.0.0

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jewelerp"

# ─── Auth (REQUIRED in staging/production) ──────────────────
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-this-too-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"
REFRESH_TOKEN_MAX_PER_USER=5

# ─── Cookies ───────────────────────────────────────────────
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.com
COOKIE_SAMESITE=lax

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated allowed origins. Omit for same-origin in production.
CORS_ORIGINS=http://localhost:5173

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15

# ─── Logging ───────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug

# ─── Proxy / Networking ────────────────────────────────────
# 0 = none, 1 = behind nginx, 2 = behind CDN+nginx
TRUST_PROXY=0

# ─── Static File Serving ───────────────────────────────────
# In production, Express serves the Vite build from dist/
SERVE_STATIC=false
STATIC_DIR=dist

# ─── Graceful Shutdown ─────────────────────────────────────
SHUTDOWN_TIMEOUT_MS=10000

# ─── Seed defaults ─────────────────────────────────────────
DEFAULT_COMPANY_NAME="Your Company Name"
DEFAULT_BRANCH_NAME="Main Branch"

# ─── Frontend (Vite build-time) ────────────────────────────
# Only used during 'vite build'. For runtime config, edit public/config.js
# VITE_API_URL=https://api.jewelerp.com/api

# ─── GST API ───────────────────────────────────────────────
# Official GST taxpayer lookup API base URL
# Endpoint used: GET {GST_API_BASE_URL}/commonapi/v1.3/search?gstin={}&action=TP
GST_API_BASE_URL=https://api.gst.gov.in

# ─── Docker / Infrastructure ───────────────────────────────
POSTGRES_PASSWORD=changeme

# ─── Backup (container-level) ──────────────────────────────
BACKUP_ENABLED=false
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30
