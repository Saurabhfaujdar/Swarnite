# ─────────────────────────────────────────────────────────────
# JewelERP — STAGING Environment
# ─────────────────────────────────────────────────────────────
# Used in docker-compose or CI/CD for staging deployment.
# Secrets should come from your CI/CD secrets store.
# ─────────────────────────────────────────────────────────────

NODE_ENV=staging
PORT=3001
APP_VERSION=1.0.0

# Database (staging DB, separate from production!)
DATABASE_URL="postgresql://jewelerp:STAGING_DB_PASSWORD@db:5432/jewelerp_staging"

# Auth — use UNIQUE secrets, different from production
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_STAGING_REFRESH_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_MAX_PER_USER=5

# Cookies
COOKIE_SECURE=true
COOKIE_DOMAIN=.staging.jewelerp.com
COOKIE_SAMESITE=strict

# CORS — staging frontend URL
CORS_ORIGINS=https://staging.jewelerp.com

# Rate limiting (slightly relaxed for QA testing)
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=15

# Logging — more verbose than production for debugging
LOG_LEVEL=info

# Proxy
TRUST_PROXY=1

# Static serving — Express serves the built frontend
SERVE_STATIC=true
STATIC_DIR=dist

# Docker
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD

# Backup
BACKUP_ENABLED=true
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAYS=7
