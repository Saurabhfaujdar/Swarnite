# ─────────────────────────────────────────────────────────────
# JewelERP — PRODUCTION Environment
# ─────────────────────────────────────────────────────────────
# DO NOT commit real secrets here. Use your CI/CD secrets store
# or Docker secrets to inject JWT_SECRET, REFRESH_TOKEN_SECRET,
# DATABASE_URL, and POSTGRES_PASSWORD at deploy time.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001
APP_VERSION=1.0.0

# Database — injected via secrets manager / CI variable
DATABASE_URL=REPLACE_OR_INJECT_VIA_SECRETS

# Auth — MUST be unique, random 128-char hex strings
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_OR_INJECT_VIA_SECRETS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_OR_INJECT_VIA_SECRETS
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_MAX_PER_USER=5

# Cookies
COOKIE_SECURE=true
COOKIE_DOMAIN=.jewelerp.com
COOKIE_SAMESITE=strict

# CORS — production frontend URL (same domain = no CORS needed)
# CORS_ORIGINS=https://jewelerp.com

# Rate limiting — strict in production
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info

# Proxy — 1 for nginx, 2 for CDN + nginx
TRUST_PROXY=1

# Static serving
SERVE_STATIC=true
STATIC_DIR=dist

# Docker
POSTGRES_PASSWORD=REPLACE_OR_INJECT_VIA_SECRETS

# Backup
BACKUP_ENABLED=true
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30
